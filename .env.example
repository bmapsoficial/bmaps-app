# EXPERIMENTO (branch experimento/firebase-auth)
# Copie para .env (que NÃO vai para o Git) e preencha com os dados do app Web
# do projeto Firebase (Console do Firebase > Configurações do projeto > Seus apps).
# Estes valores identificam o projeto; não coloque aqui chaves privadas nem contas
# de serviço — essas ficam só como segredo do Worker.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
